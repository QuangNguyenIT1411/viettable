# Required for SQL Server container (must match SQL Server password policy)
MSSQL_SA_PASSWORD=CHANGE_ME_WITH_A_STRONG_LOCAL_PASSWORD

# Shared by Identity (issuer) and Gateway (validator). Use at least 32 random bytes outside local development.
MOBILE_JWT_SIGNING_KEY=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_BYTES

# VNPAY Sandbox. Keep disabled until credentials from sandbox.vnpayment.vn are available.
# Never commit the real hash secret. The IPN URL is configured in the VNPAY merchant portal.
VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://your-public-host.example/api/payments/providers/vnpay/return
VNPAY_EXPIRY_MINUTES=15
