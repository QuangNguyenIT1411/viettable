# Build context: SelfRestaurant-master. Preparation only; no deployment command.
FROM node:22-bookworm-slim AS staff
WORKDIR /src
COPY src/Frontend/selfrestaurant-chef-web/ chef/
COPY src/Frontend/selfrestaurant-cashier-web/ cashier/
COPY src/Frontend/selfrestaurant-admin-web/ admin/
RUN cd chef && npm ci && npm run build
RUN cd cashier && npm ci && npm run build
RUN cd admin && npm ci && npm run build

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS backend
WORKDIR /src
COPY src/Backend/ src/Backend/
COPY src/Gateway/ src/Gateway/
COPY src/Services/ src/Services/
COPY src/Shared/ src/Shared/
COPY sql/billing-owned-tables.sql sql/billing-owned-tables.sql
RUN dotnet publish src/Backend/VietTable.CloudHost/VietTable.CloudHost.csproj -c Release -o /publish

FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
COPY --from=backend /publish/ ./
COPY --from=staff /src/chef/dist/ wwwroot/chef-app/
COPY --from=staff /src/cashier/dist/ wwwroot/cashier-app/
COPY --from=staff /src/admin/dist/ wwwroot/admin-app/
ENV PORT=80 ASPNETCORE_ENVIRONMENT=Production
USER app
STOPSIGNAL SIGTERM
ENTRYPOINT ["dotnet", "VietTable.CloudHost.dll"]
