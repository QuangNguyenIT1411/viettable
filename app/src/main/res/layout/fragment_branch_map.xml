<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream">

    <!-- Legacy map canvas remains hidden until the API provides real coordinates. -->
    <FrameLayout
        android:id="@+id/mapCanvas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/pd_surface_2"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Stylized Map Grid and Streets -->
        <View
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="160dp"
            android:background="@color/pd_surface_2" />

        <View
            android:layout_width="16dp"
            android:layout_height="match_parent"
            android:layout_marginStart="140dp"
            android:background="@color/pd_surface_2" />

        <View
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:layout_marginTop="320dp"
            android:background="@color/pd_surface_2" />

        <!-- Decorative legacy location pin. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="180dp"
            android:layout_marginTop="280dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_location"
                app:tint="@color/semantic_info" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="Vị trí của bạn"
                android:textColor="@color/primary_dark"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Branch Marker 1: Hoàn Kiếm -->
        <LinearLayout
            android:id="@+id/markerHoanKiem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="240dp"
            android:layout_marginTop="190dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_location"
                app:tint="@color/primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text=""
                android:textColor="@color/primary_dark"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Branch Marker 2: Ba Đình -->
        <LinearLayout
            android:id="@+id/markerBaDinh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="80dp"
            android:layout_marginTop="120dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_location"
                app:tint="@color/primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text=""
                android:textColor="@color/primary_dark"
                android:textSize="10sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Top Bar with Back -->
    <LinearLayout
        android:id="@+id/topBarMap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        android:tag="safe_top"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_badge"
            android:contentDescription="@string/a11y_back"
            android:src="@drawable/ic_back"
            app:tint="@color/primary_dark" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:text="Bản đồ chi nhánh gần bạn"
            android:textColor="@color/primary_dark"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Sliding Card with Nearest Branch -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardNearestBranch"
        style="@style/Widget.VietTable.Card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:tag="safe_bottom">

            <TextView
                android:id="@+id/tvMapBranchName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMapBranchAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChooseMapBranch"
                style="@style/Widget.VietTable.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="12dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Chọn chi nhánh này"
                android:textSize="13sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
