<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:elevation="1dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_back"
            app:navigationContentDescription="@string/a11y_back"
            app:navigationIconTint="@color/text_primary"
            app:title="Tiến độ món ăn"
            app:titleTextColor="@color/text_primary" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentOrderTracking"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="96dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Tier 1: Order-Level Lifecycle Stepper Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.VietTable.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Tiến độ đợt gọi mới nhất"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvTrackingOrderId"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_status_chip"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text=""
                            android:textColor="@color/primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- 4-Step Visual Stepper Bar -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Step 1: Đã gửi (PLACED) -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/ivStep1"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_round_floating_btn"
                                android:backgroundTint="@color/semantic_success"
                                android:padding="7dp"
                                android:src="@drawable/ic_check"
                                app:tint="@color/pd_on_color" />

                            <TextView
                                android:id="@+id/tvStep1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Đã gửi"
                                android:textColor="@color/semantic_success"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View
                            android:id="@+id/line1To2"
                            android:layout_width="0dp"
                            android:layout_height="2.5dp"
                            android:layout_marginBottom="12dp"
                            android:layout_weight="0.8"
                            android:background="@color/semantic_success" />

                        <!-- Step 2: Xác nhận (CONFIRMED) -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/ivStep2"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_round_floating_btn"
                                android:backgroundTint="@color/semantic_success"
                                android:padding="7dp"
                                android:src="@drawable/ic_check"
                                app:tint="@color/pd_on_color" />

                            <TextView
                                android:id="@+id/tvStep2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Xác nhận"
                                android:textColor="@color/semantic_success"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View
                            android:id="@+id/line2To3"
                            android:layout_width="0dp"
                            android:layout_height="2.5dp"
                            android:layout_marginBottom="12dp"
                            android:layout_weight="0.8"
                            android:background="@color/accent_gold" />

                        <!-- Step 3: Đang xử lý (IN_PROGRESS) -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/ivStep3"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_round_floating_btn"
                                android:backgroundTint="@color/accent_gold"
                                android:padding="7dp"
                                android:src="@drawable/ic_clock"
                                app:tint="@color/pd_on_color" />

                            <TextView
                                android:id="@+id/tvStep3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Đang xử lý"
                                android:textColor="@color/accent_gold_dark"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View
                            android:id="@+id/line3To4"
                            android:layout_width="0dp"
                            android:layout_height="2.5dp"
                            android:layout_marginBottom="12dp"
                            android:layout_weight="0.8"
                            android:background="@color/divider" />

                        <!-- Step 4: Hoàn thành (COMPLETED) -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/ivStep4"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_round_floating_btn"
                                android:backgroundTint="@color/divider"
                                android:padding="7dp"
                                android:src="@drawable/ic_cutlery"
                                app:tint="@color/text_secondary" />

                            <TextView
                                android:id="@+id/tvStep4"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Hoàn thành"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- "x/y món đã xong" (owner, 26/10): ready or served dishes out of all dishes not cancelled. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDishesDone"
                style="@style/Widget.VietTable.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/pd_surface"
                app:cardCornerRadius="@dimen/pd_radius_card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvDishesDoneCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.VietTable.Display.XL"
                            android:textColor="@color/pd_yellow"
                            tools:text="3/5" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:text="món đã xong"
                            android:textAppearance="@style/TextAppearance.VietTable.Body"
                            android:textColor="@color/pd_muted" />
                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressDishesDone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:max="100"
                        app:indicatorColor="@color/pd_yellow"
                        app:trackColor="@color/pd_surface_2"
                        app:trackCornerRadius="6dp"
                        app:trackThickness="10dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tier 2: Item-Level Status List Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tiến độ từng món ăn"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRefreshOrderStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_category_chip"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:text="Chạm để cập nhật trạng thái từ bếp"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Nhấn vào món để xem chi tiết bếp và ước tính thời gian"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTrackedItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/layoutOrderTrackingState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progressOrderTracking"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/tvOrderTrackingState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetryOrderTracking"
            style="@style/Widget.VietTable.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/state_retry"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Bottom Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:tag="safe_bottom"
        android:background="@color/surface"
        android:elevation="8dp"
        android:padding="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackToSession"
            style="@style/Widget.VietTable.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height_primary"
            android:text="Về trang bàn ăn" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
