<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Photographic Background (Real photo from Internet, no solid color) -->
    <ImageView
        android:id="@+id/ivSplashBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/splash_bg"
        android:contentDescription="@null" />

    <!-- Dark Scrim Overlay for Contrast and Text Readability -->
    <View
        android:id="@+id/vSplashScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_splash_scrim" />

    <!-- Center Content: Brand Emblem, Title and Tagline -->
    <LinearLayout
        android:id="@+id/layoutCenterBrand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        app:layout_constraintBottom_toTopOf="@+id/layoutBottomStatus"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.45"
        app:layout_constraintVertical_chainStyle="spread_inside">

        <!-- Real Icon / Brand Emblem (PNG, no vector) -->
        <FrameLayout
            android:layout_width="108dp"
            android:layout_height="108dp"
            android:background="@drawable/bg_splash_emblem_container">

            <ImageView
                android:id="@+id/ivSplashLogo"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_splash_lotus_3d"
                android:contentDescription="@string/app_name" />
        </FrameLayout>

        <!-- Main Title -->
        <TextView
            android:id="@+id/tvSplashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:letterSpacing="0.08"
            android:shadowColor="#1A000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:text="@string/app_name"
            android:textColor="@color/primary"
            android:textSize="36sp"
            android:textStyle="bold" />

        <!-- Gold Accent Divider -->
        <View
            android:layout_width="36dp"
            android:layout_height="3dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_splash_gold_bar" />

        <!-- Tagline -->
        <TextView
            android:id="@+id/tvSplashTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:letterSpacing="0.05"
            android:text="@string/app_tagline"
            android:textColor="@color/accent_gold_dark"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Bottom Status Section -->
    <LinearLayout
        android:id="@+id/layoutBottomStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="44dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ProgressBar
            android:id="@+id/pbSplashLoading"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:indeterminateTint="@color/primary" />

        <TextView
            android:id="@+id/tvSplashStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:letterSpacing="0.02"
            android:text="Đang kết nối hệ thống nhà hàng..."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:letterSpacing="0.02"
            android:text="Hệ thống ẩm thực truyền thống Việt Nam"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
