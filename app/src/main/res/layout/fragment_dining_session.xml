<?xml version="1.0" encoding="utf-8"?>
<!-- Phiên bàn "Phố đêm" (DESIGN_PHO_DEM.md sections 5–6): mint glow (at the table), branch label, table title
     Display.XL, status pill, running total card, yellow "Gọi thêm món", three action tiles, order rounds.
     Written from scratch; view IDs used by DiningSessionFragment are kept (the toolbar is now a round home button). -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pd_bg">

    <View
        android:layout_width="460dp"
        android:layout_height="460dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="-220dp"
        android:layout_marginTop="-170dp"
        android:background="@drawable/pd_glow_mint"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/pd_screen_margin"
            android:paddingTop="12dp"
            android:tag="safe_top">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/pd_circle_surface2"
                android:contentDescription="Về trang chủ"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_home"
                app:tint="@color/pd_cream" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvSessionStatusBadge"
                style="@style/Widget.VietTable.StatusPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="ĐANG PHỤC VỤ" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/sessionContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/pd_screen_margin"
                    android:paddingTop="20dp"
                    android:paddingBottom="32dp"
                    android:tag="safe_bottom">

                    <TextView
                        android:id="@+id/tvSessionBranch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.VietTable.Label"
                        android:textColor="@color/pd_yellow"
                        tools:text="Chi nhánh Quận 1" />

                    <TextView
                        android:id="@+id/tvSessionTable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:accessibilityHeading="true"
                        android:textAppearance="@style/TextAppearance.VietTable.Display.XL"
                        tools:text="Bàn B4" />

                    <TextView
                        android:id="@+id/tvSessionId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textAppearance="@style/TextAppearance.VietTable.Caption"
                        android:textColor="@color/pd_muted"
                        tools:text="Phiên: #20 • Bắt đầu: 18:42, 27/10/2026" />

                    <TextView
                        android:id="@+id/tvSessionDuration"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="@style/TextAppearance.VietTable.Caption"
                        android:textColor="@color/pd_muted"
                        android:visibility="gone" />

                    <!-- Running total -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:background="@drawable/pd_card_surface"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="22dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tổng tạm tính"
                                android:textAppearance="@style/TextAppearance.VietTable.Caption"
                                android:textColor="@color/pd_muted" />

                            <TextView
                                android:id="@+id/tvEstimatedTotalAmount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textAppearance="@style/TextAppearance.VietTable.Price"
                                android:textColor="@color/pd_yellow"
                                tools:text="272.500đ" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:gravity="end"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvTotalDishesCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.VietTable.Display.M"
                                tools:text="5 món" />

                            <TextView
                                android:id="@+id/tvOrderRoundsCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textAppearance="@style/TextAppearance.VietTable.Caption"
                                android:textColor="@color/pd_muted"
                                tools:text="2 đợt" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/cardOrderMore"
                        style="@style/Widget.VietTable.Button.Primary.Arrow"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginTop="16dp"
                        android:text="Gọi thêm món" />

                    <!-- Track / call staff / pay -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/cardTrackOrder"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/pd_tile"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="16dp">

                            <ImageView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/pd_circle_yellow"
                                android:importantForAccessibility="no"
                                android:padding="11dp"
                                android:src="@drawable/ic_clock"
                                app:tint="@color/pd_on_color" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:gravity="center"
                                android:text="Tiến độ món"
                                android:textAppearance="@style/TextAppearance.VietTable.Body.Strong" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/cardCallStaff"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:background="@drawable/pd_tile"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="16dp">

                            <ImageView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/pd_circle_red"
                                android:importantForAccessibility="no"
                                android:padding="11dp"
                                android:src="@drawable/ic_service_staff"
                                app:tint="@color/pd_cream" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:gravity="center"
                                android:text="Gọi nhân viên"
                                android:textAppearance="@style/TextAppearance.VietTable.Body.Strong" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/cardRequestPayment"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:background="@drawable/pd_tile"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="16dp">

                            <ImageView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/pd_circle_mint"
                                android:importantForAccessibility="no"
                                android:padding="11dp"
                                android:src="@drawable/ic_card"
                                app:tint="@color/pd_on_color" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:gravity="center"
                                android:text="Thanh toán"
                                android:textAppearance="@style/TextAppearance.VietTable.Body.Strong" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Orders in this session -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Các đợt gọi món"
                            android:textAppearance="@style/TextAppearance.VietTable.Display.M" />

                        <TextView
                            android:id="@+id/tvViewAllCurrentOrders"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center"
                            android:minHeight="48dp"
                            android:paddingHorizontal="4dp"
                            android:text="Xem tất cả"
                            android:textAppearance="@style/TextAppearance.VietTable.Body.Strong"
                            android:textColor="@color/pd_yellow" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvSessionOrders"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:nestedScrollingEnabled="false" />

                    <!-- Leave the table: shown only while no order round was sent -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCancelTable"
                        style="@style/Widget.VietTable.Button.Ghost"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="24dp"
                        android:text="Hủy bàn"
                        android:textColor="@color/pd_red"
                        android:visibility="gone"
                        app:strokeColor="@color/pd_red" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDiningReturnHome"
                        style="@style/Widget.VietTable.Button.Ghost"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="16dp"
                        android:text="Về trang chủ" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <LinearLayout
                android:id="@+id/emptySessionState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:tag="safe_bottom"
                android:visibility="gone">

                <ImageView
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:background="@drawable/pd_circle_surface2"
                    android:contentDescription="@null"
                    android:padding="24dp"
                    android:src="@drawable/ic_qr_scan"
                    app:tint="@color/pd_dim" />

                <TextView
                    android:id="@+id/tvEmptySessionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.VietTable.Display.M" />

                <TextView
                    android:id="@+id/tvEmptySessionMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.VietTable.Body"
                    android:textColor="@color/pd_muted" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEmptySessionPrimary"
                    style="@style/Widget.VietTable.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEmptySessionReturnHome"
                    style="@style/Widget.VietTable.Button.Ghost"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="12dp"
                    android:text="Về trang chủ" />
            </LinearLayout>

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progressSession"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/pd_yellow" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
