<?xml version="1.0" encoding="utf-8"?>
<!-- "Đánh giá bữa ăn" (owner 05/11), "Phố đêm": "Đã dùng bữa" badge, overall stars, Món ăn / Phục vụ / Không gian
     (each chosen by the guest), optional stars per dish of the invoice, quick tags from the server, comment, anonymous
     switch, the restaurant's reply, and the 24-hour edit window. Star rows and chips are built by ReviewFragment. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pd_bg">

    <View
        android:layout_width="440dp"
        android:layout_height="440dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-200dp"
        android:layout_marginEnd="-200dp"
        android:background="@drawable/pd_glow_yellow"
        android:importantForAccessibility="no" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:tag="safe_top">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="140dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="@dimen/pd_screen_margin"
                android:background="@drawable/pd_circle_surface2"
                android:contentDescription="@string/a11y_back"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_back"
                app:tint="@color/pd_text" />

            <TextView
                android:id="@+id/tvReviewInvoiceMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/pd_screen_margin"
                android:layout_marginTop="20dp"
                android:textAppearance="@style/TextAppearance.VietTable.Label"
                android:textColor="@color/pd_yellow_text" />

            <TextView
                android:id="@+id/tvReviewTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/pd_screen_margin"
                android:layout_marginTop="6dp"
                android:accessibilityHeading="true"
                android:text="Bữa ăn thế nào?"
                android:textAppearance="@style/TextAppearance.VietTable.Display.XL" />

            <TextView
                android:id="@+id/tvDinedBadge"
                style="@style/Widget.VietTable.StatusPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/pd_screen_margin"
                android:layout_marginTop="10dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvReviewLockNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/pd_screen_margin"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.VietTable.Caption"
                android:textColor="@color/pd_muted"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvReviewHidden"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/pd_screen_margin"
                android:layout_marginTop="12dp"
                android:background="@drawable/pd_card_red_soft"
                android:padding="14dp"
                android:textAppearance="@style/TextAppearance.VietTable.Body"
                android:textColor="@color/pd_red_text"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/progressReview"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="40dp"
                android:indeterminateTint="@color/pd_yellow" />

            <LinearLayout
                android:id="@+id/contentReview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Overall -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/pd_screen_margin"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/pd_card_surface"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Tổng thể"
                        android:textAppearance="@style/TextAppearance.VietTable.Label" />

                    <LinearLayout
                        android:id="@+id/layoutOverallStars"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal" />

                    <TextView
                        android:id="@+id/tvRatingPrompt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.VietTable.Body.Strong" />
                </LinearLayout>

                <!-- Món ăn / Phục vụ / Không gian -->
                <LinearLayout
                    android:id="@+id/layoutCriteria"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/pd_screen_margin"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/pd_card_surface"
                    android:orientation="vertical"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="10dp" />

                <TextView
                    android:id="@+id/tvTagsHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/pd_screen_margin"
                    android:layout_marginTop="24dp"
                    android:text="Nhanh gọn"
                    android:textAppearance="@style/TextAppearance.VietTable.Label" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupReviewTags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/pd_screen_margin"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tvDishHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/pd_screen_margin"
                    android:layout_marginTop="24dp"
                    android:text="Chấm từng món (tuỳ chọn)"
                    android:textAppearance="@style/TextAppearance.VietTable.Label" />

                <LinearLayout
                    android:id="@+id/layoutDishRatings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/pd_screen_margin"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/pd_card_surface"
                    android:orientation="vertical"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="10dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/pd_screen_margin"
                    android:layout_marginTop="24dp"
                    android:text="Nhận xét"
                    android:textAppearance="@style/TextAppearance.VietTable.Label" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilReviewComment"
                    style="@style/Widget.VietTable.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/pd_screen_margin"
                    android:layout_marginTop="8dp"
                    android:hint="Món nào ngon, chỗ nào cần cải thiện…"
                    app:counterEnabled="true"
                    app:counterMaxLength="2000">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etReviewComment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:inputType="textMultiLine|textCapSentences"
                        android:minLines="3" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchReviewAnonymous"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/pd_screen_margin"
                    android:layout_marginTop="12dp"
                    android:minHeight="48dp"
                    android:text="Ẩn tên của tôi (hiện “Khách ẩn danh”)"
                    android:textAppearance="@style/TextAppearance.VietTable.Body" />

                <LinearLayout
                    android:id="@+id/layoutReviewReply"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/pd_screen_margin"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/pd_card_mint_soft"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nhà hàng trả lời"
                        android:textAppearance="@style/TextAppearance.VietTable.Label"
                        android:textColor="@color/pd_mint_text" />

                    <TextView
                        android:id="@+id/tvReviewReply"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textAppearance="@style/TextAppearance.VietTable.Body" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvReviewError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/pd_screen_margin"
                    android:layout_marginTop="12dp"
                    android:textAppearance="@style/TextAppearance.VietTable.Body"
                    android:textColor="@color/pd_red_text"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/pd_fade_bottom"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/pd_screen_margin"
        android:paddingTop="28dp"
        android:paddingBottom="20dp"
        android:tag="safe_bottom">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitReview"
            style="@style/Widget.VietTable.Button.Primary.Arrow"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:enabled="false"
            android:text="Gửi đánh giá" />
    </LinearLayout>
</FrameLayout>
