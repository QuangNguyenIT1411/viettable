<?xml version="1.0" encoding="utf-8"?>
<!-- Booking wizard progress "Phố đêm": step name + fraction, then five pill segments (DESIGN_PHO_DEM.md section 6
     "Đặt bàn"). View IDs are kept; progressWizard takes the same setProgress(0..100). -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/pd_screen_margin"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvWizardStepName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAllCaps="true"
            android:textAppearance="@style/TextAppearance.VietTable.Label"
            android:textColor="@color/pd_yellow"
            tools:text="Bước 1: Chọn ngày" />

        <TextView
            android:id="@+id/tvWizardStepFraction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textAppearance="@style/TextAppearance.VietTable.Label"
            android:textColor="@color/pd_muted"
            tools:text="1/5" />
    </LinearLayout>

    <com.restaurant.viettable.ui.common.PdStepSegments
        android:id="@+id/progressWizard"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="10dp" />
</LinearLayout>
