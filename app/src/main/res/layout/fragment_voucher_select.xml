<?xml version="1.0" encoding="utf-8"?>
<!-- Chọn Voucher "Phố đêm": code input pill + apply, plum offer cards, yellow confirm button. Written from scratch;
     view IDs used by VoucherSelectFragment are kept (the toolbar is now a round back button). -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pd_bg">

    <View
        android:layout_width="440dp"
        android:layout_height="440dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-200dp"
        android:layout_marginEnd="-200dp"
        android:background="@drawable/pd_glow_red"
        android:importantForAccessibility="no" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:tag="safe_top">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/pd_screen_margin"
            android:paddingTop="12dp"
            android:paddingBottom="140dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/pd_circle_surface2"
                android:contentDescription="@string/a11y_back"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_back"
                app:tint="@color/pd_cream" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="ƯU ĐÃI"
                android:textAppearance="@style/TextAppearance.VietTable.Label"
                android:textColor="@color/pd_yellow" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityHeading="true"
                android:text="Chọn Voucher ưu đãi"
                android:textAppearance="@style/TextAppearance.VietTable.Display.XL" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilVoucherCode"
                    style="@style/Widget.VietTable.TextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Nhập mã khuyến mãi"
                    app:startIconDrawable="@drawable/ic_voucher">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etVoucherCode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapCharacters"
                        android:minHeight="54dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnApplyCode"
                    style="@style/Widget.VietTable.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:layout_marginStart="10dp"
                    android:minHeight="56dp"
                    android:paddingHorizontal="20dp"
                    android:text="Áp dụng" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Ưu đãi dành cho bạn"
                android:textAppearance="@style/TextAppearance.VietTable.Display.M" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvVouchers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false" />

            <!-- Loading / no voucher / error (ListState), owner 28/10: never an empty list without a word. -->
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progressVouchers"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:indeterminate="true"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvVoucherState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.VietTable.Body"
                android:textColor="@color/pd_muted"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetryVouchers"
                style="@style/Widget.VietTable.Button.Ghost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:text="@string/state_retry"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="96dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/pd_fade_bottom"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/pd_screen_margin"
        android:paddingTop="28dp"
        android:paddingBottom="16dp"
        android:tag="safe_bottom">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmVoucher"
            style="@style/Widget.VietTable.Button.Primary.Arrow"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Áp dụng Voucher này" />
    </LinearLayout>
</FrameLayout>
