<?xml version="1.0" encoding="utf-8"?>
<!-- Đặt bàn bước 2 "Phố đêm": time chips in a 3-column grid (sized by ResTimeFragment), past slots dimmed.
     Written from scratch; view IDs used by ResTimeFragment are kept. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pd_bg">

    <View
        android:layout_width="440dp"
        android:layout_height="440dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-200dp"
        android:layout_marginEnd="-200dp"
        android:background="@drawable/pd_glow_yellow"
        android:importantForAccessibility="no" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:tag="safe_top">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="140dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="@dimen/pd_screen_margin"
                android:background="@drawable/pd_circle_surface2"
                android:contentDescription="@string/a11y_back"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_back"
                app:tint="@color/pd_cream" />

            <TextView
                android:id="@+id/tvDateSelectedDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/pd_screen_margin"
                android:layout_marginTop="28dp"
                android:textAllCaps="true"
                android:textAppearance="@style/TextAppearance.VietTable.Label"
                tools:text="Ngày đã chọn: 27/10/2026" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/pd_screen_margin"
                android:layout_marginTop="8dp"
                android:accessibilityHeading="true"
                android:text="Chọn khung giờ"
                android:textAppearance="@style/TextAppearance.VietTable.Display.XL" />

            <include
                android:id="@+id/wizardProgress"
                layout="@layout/view_wizard_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/pd_screen_margin"
                android:layout_marginTop="24dp"
                android:text="Buổi trưa (10:00 - 14:30)"
                android:textAppearance="@style/TextAppearance.VietTable.Display.M" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupLunch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/pd_screen_margin"
                android:layout_marginTop="12dp"
                app:chipSpacingHorizontal="10dp"
                app:chipSpacingVertical="4dp"
                app:singleSelection="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/pd_screen_margin"
                android:layout_marginTop="24dp"
                android:text="Buổi chiều tối (15:00 - 21:30)"
                android:textAppearance="@style/TextAppearance.VietTable.Display.M" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupDinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/pd_screen_margin"
                android:layout_marginTop="12dp"
                app:chipSpacingHorizontal="10dp"
                app:chipSpacingVertical="4dp"
                app:singleSelection="true" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/pd_fade_bottom"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/pd_screen_margin"
        android:paddingTop="28dp"
        android:paddingBottom="16dp"
        android:tag="safe_bottom">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinue"
            style="@style/Widget.VietTable.Button.Primary.Arrow"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="@string/btn_continue" />
    </LinearLayout>
</FrameLayout>
