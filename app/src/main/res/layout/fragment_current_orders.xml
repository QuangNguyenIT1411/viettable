<?xml version="1.0" encoding="utf-8"?>
<!-- Đơn hiện tại "Phố đêm" (DESIGN_PHO_DEM.md section 6 "Tiến độ món / Đơn hiện tại"): table label, Display.XL
     title, summary card (dishes, subtotal in yellow), order rounds, Ghost "Gọi thêm món" + yellow "Tiến độ món".
     Written from scratch; view IDs used by CurrentOrdersFragment are kept (the toolbar is now a round back button
     that stays visible in the empty / error state). -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pd_bg">

    <View
        android:layout_width="440dp"
        android:layout_height="440dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-200dp"
        android:layout_marginEnd="-200dp"
        android:background="@drawable/pd_glow_yellow"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/pd_screen_margin"
            android:paddingTop="12dp"
            android:tag="safe_top">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/pd_circle_surface2"
                android:contentDescription="@string/a11y_back"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_back"
                app:tint="@color/pd_cream" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/contentCurrentOrders"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/pd_screen_margin"
                    android:paddingTop="20dp"
                    android:paddingBottom="128dp">

                    <TextView
                        android:id="@+id/tvCurrentOrdersTable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.VietTable.Label"
                        android:textColor="@color/pd_yellow"
                        tools:text="Bàn B4 • Chi nhánh Quận 1" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:accessibilityHeading="true"
                        android:text="Đơn hiện tại"
                        android:textAppearance="@style/TextAppearance.VietTable.Display.XL" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:background="@drawable/pd_card_surface"
                        android:baselineAligned="false"
                        android:orientation="horizontal"
                        android:padding="22dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tổng số món"
                                android:textAppearance="@style/TextAppearance.VietTable.Caption"
                                android:textColor="@color/pd_muted" />

                            <TextView
                                android:id="@+id/tvTotalItems"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textAppearance="@style/TextAppearance.VietTable.Display.L"
                                tools:text="5 món" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tạm tính"
                                android:textAppearance="@style/TextAppearance.VietTable.Caption"
                                android:textColor="@color/pd_muted" />

                            <TextView
                                android:id="@+id/tvTotalSubtotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textAppearance="@style/TextAppearance.VietTable.Price"
                                android:textColor="@color/pd_yellow"
                                tools:text="272.500đ" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:text="Chi tiết từng đợt gọi"
                        android:textAppearance="@style/TextAppearance.VietTable.Display.M" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvCurrentOrders"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:nestedScrollingEnabled="false" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <LinearLayout
                android:id="@+id/layoutCurrentOrdersState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progressCurrentOrders"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorColor="@color/pd_yellow" />

                <TextView
                    android:id="@+id/tvCurrentOrdersState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableTop="@drawable/ic_cutlery"
                    android:drawablePadding="14dp"
                    android:drawableTint="@color/pd_dim"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.VietTable.Body"
                    android:textColor="@color/pd_muted" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRetryCurrentOrders"
                    style="@style/Widget.VietTable.Button.Ghost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/state_retry"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Bottom actions over a fade -->
            <LinearLayout
                android:id="@+id/bottomActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="@drawable/pd_fade_bottom"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/pd_screen_margin"
                android:paddingTop="28dp"
                android:paddingBottom="16dp"
                android:tag="safe_bottom">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOrderMoreDishes"
                    style="@style/Widget.VietTable.Button.Ghost"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:paddingHorizontal="8dp"
                    android:text="Gọi thêm món"
                    app:autoSizeMaxTextSize="16sp"
                    app:autoSizeMinTextSize="11sp"
                    app:autoSizeTextType="uniform"
                    android:backgroundTint="@color/pd_surface_2"
                    app:backgroundTint="@color/pd_surface_2" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTrackItemsProgress"
                    style="@style/Widget.VietTable.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1.2"
                    android:maxLines="1"
                    android:paddingHorizontal="8dp"
                    android:text="Tiến độ món"
                    app:autoSizeMaxTextSize="16sp"
                    app:autoSizeMinTextSize="11sp"
                    app:autoSizeTextType="uniform" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
