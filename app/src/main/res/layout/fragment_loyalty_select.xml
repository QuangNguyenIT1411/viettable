<?xml version="1.0" encoding="utf-8"?>
<!-- Dùng điểm "Phố đêm" (DESIGN_PHO_DEM.md section 2/5: plum points card, stepper, yellow button). Written from
     scratch; view IDs used by LoyaltySelectFragment are kept (the toolbar is now a round back button). The confirm
     logic (wait for the server, never claim success alone) is unchanged. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pd_bg">

    <View
        android:layout_width="440dp"
        android:layout_height="440dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-200dp"
        android:layout_marginEnd="-200dp"
        android:background="@drawable/pd_glow_red"
        android:importantForAccessibility="no" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:tag="safe_top">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/pd_screen_margin"
            android:paddingTop="12dp"
            android:paddingBottom="140dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/pd_circle_surface2"
                android:contentDescription="@string/a11y_back"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_back"
                app:tint="@color/pd_cream" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="ĐIỂM THƯỞNG"
                android:textAppearance="@style/TextAppearance.VietTable.Label"
                android:textColor="@color/pd_yellow" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityHeading="true"
                android:text="Dùng điểm tích lũy"
                android:textAppearance="@style/TextAppearance.VietTable.Display.XL" />

            <!-- Balance: plum card. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/pd_card_plum"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SỐ DƯ ĐIỂM HIỆN CÓ"
                    android:textAppearance="@style/TextAppearance.VietTable.Label"
                    android:textColor="@color/pd_muted" />

                <TextView
                    android:id="@+id/tvAvailablePoints"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textAppearance="@style/TextAppearance.VietTable.Display.L"
                    tools:text="3.250 điểm" />

                <TextView
                    android:id="@+id/tvAvailableMoneyEquivalent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.VietTable.Body.Strong"
                    android:textColor="@color/pd_yellow"
                    tools:text="≈ 32.500đ" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/pd_note_box"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_info"
                    app:tint="@color/pd_yellow" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="Số tiền giảm do hệ thống tính và hiển thị trên hóa đơn sau khi bạn xác nhận."
                    android:textAppearance="@style/TextAppearance.VietTable.Caption"
                    android:textColor="@color/pd_muted" />
            </LinearLayout>

            <!-- Stepper card. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/pd_card_surface"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Số điểm muốn dùng cho hóa đơn này"
                    android:textAppearance="@style/TextAppearance.VietTable.Body"
                    android:textColor="@color/pd_muted" />

                <TextView
                    android:id="@+id/tvSelectedPoints"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.VietTable.Display.L"
                    android:textColor="@color/pd_yellow"
                    tools:text="2.000 điểm" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/pd_stepper_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="6dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMinusPoints"
                        style="@style/Widget.VietTable.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:backgroundTint="@color/pd_surface"
                        android:minWidth="76dp"
                        android:minHeight="48dp"
                        android:paddingHorizontal="12dp"
                        android:text="−"
                        android:textColor="@color/pd_cream"
                        app:backgroundTint="@color/pd_surface" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPlusPoints"
                        style="@style/Widget.VietTable.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:backgroundTint="@color/pd_cream"
                        android:minWidth="76dp"
                        android:minHeight="48dp"
                        android:paddingHorizontal="12dp"
                        android:text="+"
                        android:textColor="@color/pd_on_color"
                        app:backgroundTint="@color/pd_cream" />
                </LinearLayout>

                <!-- Server's cap: points take at most N% off the bill (filled by the code; hidden until known). -->
                <TextView
                    android:id="@+id/tvPointsCap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.VietTable.Caption"
                    android:textColor="@color/pd_muted"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvCalculatedDiscount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.VietTable.Body.Strong"
                    android:textColor="@color/pd_mint" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnQuick1000"
                        style="@style/Widget.VietTable.Button.Ghost"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:maxLines="1"
                        android:minHeight="52dp"
                        android:paddingHorizontal="8dp"
                        android:text="1.000 điểm" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnQuick2000"
                        style="@style/Widget.VietTable.Button.Ghost"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:maxLines="1"
                        android:minHeight="52dp"
                        android:paddingHorizontal="8dp"
                        android:text="2.000 điểm" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQuickMax"
                    style="@style/Widget.VietTable.Button.Ghost"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:maxLines="1"
                    android:minHeight="52dp"
                    android:text="Tối đa" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/pd_fade_bottom"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/pd_screen_margin"
        android:paddingTop="28dp"
        android:paddingBottom="16dp"
        android:tag="safe_bottom">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmPoints"
            style="@style/Widget.VietTable.Button.Primary.Arrow"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Xác nhận dùng điểm" />
    </LinearLayout>
</FrameLayout>
