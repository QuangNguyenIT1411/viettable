<?xml version="1.0" encoding="utf-8"?>
<!-- "Gợi ý món theo nhóm và ngân sách" (owner 06/11). Lines and totals are filled from the server. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pd_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/pd_screen_margin"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:tag="safe_top">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/pd_circle_surface2"
            android:contentDescription="@string/a11y_back"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back"
            app:tint="@color/pd_text" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSuggestionBranch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="THỰC ĐƠN"
                android:textAppearance="@style/TextAppearance.VietTable.Label"
                android:textColor="@color/pd_yellow_text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="Gợi ý món"
                android:textAppearance="@style/TextAppearance.VietTable.Display.M" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollSuggestion"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/pd_screen_margin"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Cho biết số người và ngân sách, VietTable gợi ý món từ thực đơn của chi nhánh. Tổng tiền đã gồm phí phục vụ và VAT, chưa trừ khuyến mãi."
                android:textAppearance="@style/TextAppearance.VietTable.BodySmall"
                android:textColor="@color/pd_muted" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.VietTable.TextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:hint="Số người">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPeople"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="2" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.VietTable.TextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Ăn chay">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etVegetarians"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="2" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.VietTable.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="Ngân sách (ví dụ 800k, 1,5tr)">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etBudget"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="text"
                    android:maxLength="20" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchNoSpicy"
                style="@style/Widget.VietTable.Switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="Không ăn cay"
                android:textAppearance="@style/TextAppearance.VietTable.Body" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSuggest"
                style="@style/Widget.VietTable.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="52dp"
                android:text="Gợi ý cho tôi" />

            <TextView
                android:id="@+id/tvSuggestionStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textAppearance="@style/TextAppearance.VietTable.Body"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layoutNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/layoutLines"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/cardTotals"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/pd_card_surface"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvTotalsBreakdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="4dp"
                    android:textAppearance="@style/TextAppearance.VietTable.Body"
                    android:textColor="@color/pd_muted" />

                <TextView
                    android:id="@+id/tvTotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.VietTable.Price" />

                <TextView
                    android:id="@+id/tvBudgetLine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.VietTable.BodySmall" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddAll"
                style="@style/Widget.VietTable.Button.Gold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:minHeight="52dp"
                android:text="Thêm tất cả vào giỏ"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
