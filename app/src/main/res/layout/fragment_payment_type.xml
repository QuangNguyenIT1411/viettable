<?xml version="1.0" encoding="utf-8"?>
<!-- Chọn phương thức thanh toán "Phố đêm" (DESIGN_PHO_DEM.md section 6): big amount, large method cards (the app
     moves on as soon as one is tapped, so there is no "selected" state). View IDs used by PaymentTypeFragment are kept;
     the toolbar is now a round back button. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pd_bg">

    <View
        android:layout_width="440dp"
        android:layout_height="440dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="-200dp"
        android:layout_marginTop="-180dp"
        android:background="@drawable/pd_glow_yellow"
        android:importantForAccessibility="no" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:tag="safe_all">

        <LinearLayout
            android:id="@+id/layoutPaymentTypeContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/pd_screen_margin"
            android:paddingTop="12dp"
            android:paddingBottom="32dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/pd_circle_surface2"
                android:contentDescription="@string/a11y_back"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_back"
                app:tint="@color/pd_cream" />

            <TextView
                android:id="@+id/tvPaymentTypeTable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:textAllCaps="true"
                android:textAppearance="@style/TextAppearance.VietTable.Label"
                tools:text="Bàn B4 · Chi nhánh Quận 1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityHeading="true"
                android:text="Hình thức thanh toán"
                android:textAppearance="@style/TextAppearance.VietTable.Display.XL" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/pd_card_surface"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SỐ TIỀN CẦN THANH TOÁN"
                    android:textAppearance="@style/TextAppearance.VietTable.Label"
                    android:textColor="@color/pd_muted" />

                <TextView
                    android:id="@+id/tvPaymentTypeGrandTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.VietTable.Display.XL"
                    android:textColor="@color/pd_yellow"
                    tools:text="610.200đ" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Chọn phương thức"
                android:textAppearance="@style/TextAppearance.VietTable.Display.M" />

            <!-- Option 1: online payment (hidden unless the VNPAY flag is on). -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPayOnline"
                style="@style/Widget.VietTable.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="104dp"
                    android:orientation="horizontal"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/pd_circle_surface2"
                        android:importantForAccessibility="no"
                        android:padding="15dp"
                        android:src="@drawable/ic_card"
                        app:tint="@color/pd_cream" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Thanh toán Online (Qua App)"
                            android:textAppearance="@style/TextAppearance.VietTable.Body.Strong" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="VietQR, Ví MoMo, ZaloPay, Thẻ ATM/Visa"
                            android:textAppearance="@style/TextAppearance.VietTable.Caption"
                            android:textColor="@color/pd_muted" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/pd_btn_arrow_ghost" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Option 2: cash. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPayOnsite"
                style="@style/Widget.VietTable.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="104dp"
                    android:orientation="horizontal"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/pd_circle_mint"
                        android:importantForAccessibility="no"
                        android:padding="15dp"
                        android:src="@drawable/ic_cash"
                        app:tint="@color/pd_on_color" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Tiền mặt"
                            android:textAppearance="@style/TextAppearance.VietTable.Display.M" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Trả tiền mặt tại bàn hoặc tại quầy thu ngân"
                            android:textAppearance="@style/TextAppearance.VietTable.Caption"
                            android:textColor="@color/pd_muted" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/pd_btn_arrow_ghost" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Option 3: bank transfer by VietQR (shown when the receiving account is configured). -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPayTransfer"
                style="@style/Widget.VietTable.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/pd_plum"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="104dp"
                    android:orientation="horizontal"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/pd_circle_yellow"
                        android:importantForAccessibility="no"
                        android:padding="15dp"
                        android:src="@drawable/ic_qr_scan"
                        app:tint="@color/pd_on_color" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Chuyển khoản VietQR"
                            android:textAppearance="@style/TextAppearance.VietTable.Display.M" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Quét mã VietQR bằng ứng dụng ngân hàng, số tiền đã điền sẵn"
                            android:textAppearance="@style/TextAppearance.VietTable.Caption"
                            android:textColor="@color/pd_muted" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/pd_btn_arrow_yellow" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
