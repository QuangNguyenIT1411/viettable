<?xml version="1.0" encoding="utf-8"?>
<!-- "Chi tiết hoá đơn" (owner 05/11), "Phố đêm": everything from the server's snapshot of the paid bill. Rows of dishes,
     amounts and payment are added by InvoiceHistoryDetailFragment (a row with 0đ is left out, never shown as 0đ). -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pd_bg">

    <View
        android:layout_width="440dp"
        android:layout_height="440dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-200dp"
        android:layout_marginEnd="-200dp"
        android:background="@drawable/pd_glow_yellow"
        android:importantForAccessibility="no" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollInvoiceDetail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:tag="safe_top">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="180dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="@dimen/pd_screen_margin"
                android:background="@drawable/pd_circle_surface2"
                android:contentDescription="@string/a11y_back"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_back"
                app:tint="@color/pd_text" />

            <LinearLayout
                android:id="@+id/layoutInvoiceDetailState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="40dp">

                <ProgressBar
                    android:id="@+id/progressInvoiceDetail"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:indeterminateTint="@color/pd_yellow" />

                <TextView
                    android:id="@+id/tvInvoiceDetailState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.VietTable.Body"
                    android:textColor="@color/pd_muted"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRetryInvoiceDetail"
                    style="@style/Widget.VietTable.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:paddingHorizontal="28dp"
                    android:text="Thử lại"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/contentInvoiceDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvInvoiceDetailCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/pd_screen_margin"
                    android:layout_marginTop="20dp"
                    android:textAppearance="@style/TextAppearance.VietTable.Label"
                    android:textColor="@color/pd_yellow_text" />

                <TextView
                    android:id="@+id/tvInvoiceDetailBranch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/pd_screen_margin"
                    android:layout_marginTop="6dp"
                    android:accessibilityHeading="true"
                    android:textAppearance="@style/TextAppearance.VietTable.Display.L" />

                <TextView
                    android:id="@+id/tvInvoiceDetailAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/pd_screen_margin"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.VietTable.Caption"
                    android:textColor="@color/pd_muted" />

                <TextView
                    android:id="@+id/tvInvoiceDetailStatus"
                    style="@style/Widget.VietTable.StatusPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/pd_screen_margin"
                    android:layout_marginTop="10dp" />

                <!-- Bàn, giờ vào – giờ thanh toán, thu ngân -->
                <LinearLayout
                    android:id="@+id/layoutInvoiceInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/pd_screen_margin"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/pd_card_surface"
                    android:orientation="vertical"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/pd_screen_margin"
                    android:layout_marginTop="24dp"
                    android:text="Món đã dùng"
                    android:textAppearance="@style/TextAppearance.VietTable.Label" />

                <LinearLayout
                    android:id="@+id/layoutInvoiceDetailItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/pd_screen_margin"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/pd_card_surface"
                    android:orientation="vertical"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="12dp" />

                <LinearLayout
                    android:id="@+id/layoutInvoiceAmounts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/pd_screen_margin"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/pd_card_surface"
                    android:orientation="vertical"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="12dp" />

                <LinearLayout
                    android:id="@+id/layoutInvoicePayment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/pd_screen_margin"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/pd_card_surface"
                    android:orientation="vertical"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="12dp" />

                <TextView
                    android:id="@+id/tvInvoiceReviewNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/pd_screen_margin"
                    android:layout_marginTop="16dp"
                    android:textAppearance="@style/TextAppearance.VietTable.Caption"
                    android:textColor="@color/pd_muted"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/layoutInvoiceActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/pd_bg"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/pd_screen_margin"
        android:paddingTop="12dp"
        android:paddingBottom="20dp"
        android:tag="safe_bottom"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExportInvoice"
            style="@style/Widget.VietTable.Button.Primary.Arrow"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Xuất hoá đơn" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnInvoiceReview"
            style="@style/Widget.VietTable.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
