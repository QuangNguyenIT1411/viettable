<?xml version="1.0" encoding="utf-8"?>
<!-- Thanh toán thành công "Phố đêm" (DESIGN_PHO_DEM.md section 6, design P06). Written from scratch;
     view IDs used by PaymentSuccessFragment and the UI tests are kept. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pd_bg">

    <View
        android:layout_width="560dp"
        android:layout_height="560dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="-170dp"
        android:background="@drawable/pd_glow_mint"
        android:importantForAccessibility="no" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollPaymentSuccess"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:tag="safe_top">

        <LinearLayout
            android:id="@+id/layoutSuccessContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/pd_screen_margin"
            android:paddingBottom="176dp">

            <!-- Badge: mint disc with a tick, dashed ring turning slowly around it. -->
            <FrameLayout
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="56dp">

                <View
                    android:id="@+id/viewSuccessRing"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/pd_ring_dash_mint"
                    android:importantForAccessibility="no" />

                <FrameLayout
                    android:id="@+id/badgeSuccess"
                    android:layout_width="156dp"
                    android:layout_height="156dp"
                    android:layout_gravity="center"
                    android:background="@drawable/pd_circle_mint">

                    <ImageView
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_check"
                        app:tint="@color/pd_on_color" />
                </FrameLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/tvSuccessTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:accessibilityHeading="true"
                android:gravity="center_horizontal"
                android:textAppearance="@style/TextAppearance.VietTable.Display.XL"
                android:textSize="32sp"
                app:lineHeight="40sp"
                tools:text="Ngon miệng nhé, Quang!" />

            <TextView
                android:id="@+id/tvSuccessSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_horizontal"
                android:text="Cảm ơn quý khách đã dùng bữa tại VietTable Restaurant."
                android:textAppearance="@style/TextAppearance.VietTable.Body"
                android:textColor="@color/pd_muted" />

            <!-- Receipt -->
            <LinearLayout
                android:id="@+id/cardSuccessReceipt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:background="@drawable/pd_card_surface"
                android:orientation="vertical"
                android:padding="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mã hóa đơn"
                        android:textAppearance="@style/TextAppearance.VietTable.Body"
                        android:textColor="@color/pd_muted" />

                    <TextView
                        android:id="@+id/tvSuccessInvoiceId"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textAppearance="@style/TextAppearance.VietTable.Body.Strong"
                        android:textColor="@color/pd_cream"
                        tools:text="HD-20261019-0412" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowSuccessTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thời gian"
                        android:textAppearance="@style/TextAppearance.VietTable.Body"
                        android:textColor="@color/pd_muted" />

                    <TextView
                        android:id="@+id/tvSuccessTime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textAppearance="@style/TextAppearance.VietTable.Body.Strong"
                        android:textColor="@color/pd_cream"
                        tools:text="21:52 · 19/10/2026" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Phương thức"
                        android:textAppearance="@style/TextAppearance.VietTable.Body"
                        android:textColor="@color/pd_muted" />

                    <TextView
                        android:id="@+id/tvSuccessMethod"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textAppearance="@style/TextAppearance.VietTable.Body.Strong"
                        android:textColor="@color/pd_cream"
                        tools:text="Chuyển khoản" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bàn &amp; chi nhánh"
                        android:textAppearance="@style/TextAppearance.VietTable.Body"
                        android:textColor="@color/pd_muted" />

                    <TextView
                        android:id="@+id/tvSuccessBranch"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textAppearance="@style/TextAppearance.VietTable.Body.Strong"
                        android:textColor="@color/pd_cream"
                        tools:text="Bàn B4 • Chi nhánh Quận 1" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="18dp"
                    android:background="@color/pd_line" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tổng cộng"
                        android:textAppearance="@style/TextAppearance.VietTable.Body"
                        android:textColor="@color/pd_muted" />

                    <TextView
                        android:id="@+id/tvSuccessAmount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textAppearance="@style/TextAppearance.VietTable.Price"
                        android:textSize="22sp"
                        tools:text="245.000đ" />
                </LinearLayout>
            </LinearLayout>

            <!-- Points earned by this payment: shown only once the server's real number arrives (owner, 26/10). -->
            <LinearLayout
                android:id="@+id/layoutPointsEarned"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/pd_card_plum_row"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_gift" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvPointsEarned"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.VietTable.Body.Strong"
                        android:textColor="@color/pd_cream"
                        tools:text="+245 điểm tích lũy mới!" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Đã cộng vào ví thành viên của bạn"
                        android:textAppearance="@style/TextAppearance.VietTable.Caption"
                        android:textColor="@color/pd_muted" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Paper falls over the page once; it never takes touches. -->
    <com.restaurant.viettable.ui.common.PdConfettiView
        android:id="@+id/viewConfetti"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Bottom actions -->
    <LinearLayout
        android:id="@+id/layoutSuccessActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/pd_bg"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/pd_screen_margin"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:tag="safe_bottom">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReviewMeal"
            style="@style/Widget.VietTable.Button.Primary.Arrow"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Đánh giá bữa ăn" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackToHomeFromPayment"
            style="@style/Widget.VietTable.Button.Ghost"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="Về trang chủ" />
    </LinearLayout>
</FrameLayout>
