<?xml version="1.0" encoding="utf-8"?>
<!-- Chi tiết đặt bàn "Phố đêm" (DESIGN_PHO_DEM.md section 6 "Lịch sử / chi tiết đặt bàn"): booking card with a thin
     yellow line and status pill, pre-order card, check-in card, change (ghost) / cancel (red). Written from scratch;
     view IDs used by ResDetailFragment are kept; buttons still show only when the current logic allows them. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pd_bg">

    <View
        android:layout_width="440dp"
        android:layout_height="440dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-200dp"
        android:layout_marginEnd="-200dp"
        android:background="@drawable/pd_glow_yellow"
        android:importantForAccessibility="no" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/pd_screen_margin"
            android:paddingTop="12dp"
            android:paddingBottom="32dp"
            android:tag="safe_all">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/pd_circle_surface2"
                android:contentDescription="@string/a11y_back"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_back"
                app:tint="@color/pd_cream" />

            <TextView
                android:id="@+id/tvDetailResId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:textAppearance="@style/TextAppearance.VietTable.Label"
                android:textColor="@color/pd_yellow"
                tools:text="#8899" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityHeading="true"
                android:text="@string/res_detail_title"
                android:textAppearance="@style/TextAppearance.VietTable.Display.XL" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/pd_card_gold_line"
                android:orientation="vertical"
                android:padding="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvDetailBranch"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.VietTable.Display.M"
                        tools:text="Chi nhánh Quận 1" />

                    <TextView
                        android:id="@+id/tvDetailStatusBadge"
                        style="@style/Widget.VietTable.StatusPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        tools:text="Đã xác nhận" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDetailDateTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:textAppearance="@style/TextAppearance.VietTable.Price"
                    android:textColor="@color/pd_yellow"
                    tools:text="19:00 • 27/10/2026" />

                <TextView
                    android:id="@+id/tvDetailTable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:drawableStart="@drawable/ic_table"
                    android:drawablePadding="8dp"
                    android:drawableTint="@color/pd_muted"
                    android:gravity="center_vertical"
                    android:textAppearance="@style/TextAppearance.VietTable.Body"
                    android:textColor="@color/pd_muted"
                    tools:text="Bàn B4 • Khu cửa sổ • 4 khách" />

                <TextView
                    android:id="@+id/tvDetailNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.VietTable.Caption"
                    android:textColor="@color/pd_muted"
                    tools:text="Ghi chú: Chuẩn bị thêm 1 ghế trẻ em." />

                <TextView
                    android:id="@+id/tvDetailStatusInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/pd_card_yellow_soft"
                    android:padding="14dp"
                    android:textAppearance="@style/TextAppearance.VietTable.Caption"
                    android:textColor="@color/pd_cream"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Pre-order -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPreOrderSection"
                style="@style/Widget.VietTable.Card.Plum"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawableStart="@drawable/ic_cutlery"
                        android:drawablePadding="10dp"
                        android:drawableTint="@color/pd_yellow"
                        android:gravity="center_vertical"
                        android:text="Món ăn đặt trước (Pre-order)"
                        android:textAppearance="@style/TextAppearance.VietTable.Display.M" />

                    <TextView
                        android:id="@+id/tvPreOrderNotice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Đặt món trước giúp bếp chuẩn bị kịp thời ngay khi bạn vừa ngồi vào bàn."
                        android:textAppearance="@style/TextAppearance.VietTable.Body"
                        android:textColor="@color/pd_muted" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGoPreOrder"
                        style="@style/Widget.VietTable.Button.Primary.Arrow"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginTop="16dp"
                        android:text="Đặt món trước ngay" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Check-in -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/pd_card_surface"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_qr_scan"
                    android:drawablePadding="10dp"
                    android:drawableTint="@color/pd_mint"
                    android:gravity="center_vertical"
                    android:text="Khi đến nhà hàng"
                    android:textAppearance="@style/TextAppearance.VietTable.Display.M" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnScanQrCheckin"
                    style="@style/Widget.VietTable.Button.Ghost.Arrow"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="16dp"
                    android:text="Quét mã QR tại bàn này" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChangeRes"
                    style="@style/Widget.VietTable.Button.Ghost"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/res_change_cta" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelRes"
                    style="@style/Widget.VietTable.Button.Red"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/res_cancel_cta" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
