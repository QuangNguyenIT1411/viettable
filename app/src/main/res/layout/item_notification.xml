<?xml version="1.0" encoding="utf-8"?>
<!-- Notification row "Phố đêm" (DESIGN_PHO_DEM.md section 6 "Thông báo"): surface row, round icon by type (set by
     NotificationAdapter), yellow unread dot. View IDs are kept. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardNotification"
    style="@style/Widget.VietTable.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="@dimen/pd_radius_row">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
            android:id="@+id/ivNotifIcon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/pd_circle_yellow"
            android:importantForAccessibility="no"
            android:padding="11dp"
            android:src="@drawable/ic_notification"
            app:tint="@color/pd_on_color" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvNotifTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.VietTable.Body.Strong"
                    tools:text="Nhắc nhở lịch đặt bàn" />

                <View
                    android:id="@+id/viewUnreadDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/pd_circle_yellow" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvNotifMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="@style/TextAppearance.VietTable.Caption"
                android:textColor="@color/pd_muted"
                tools:text="Bàn của bạn lúc 19:00 hôm nay đã sẵn sàng." />

            <TextView
                android:id="@+id/tvNotifTimestamp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.VietTable.Label"
                android:textColor="@color/pd_muted"
                tools:text="26/10 14:52" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
