<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorSurface"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Đơn hàng"
            app:titleTextColor="@color/colorTextPrimary" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayoutOrderHistory"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@color/colorSurface"
            app:tabIndicatorColor="@color/colorPrimary"
            app:tabSelectedTextColor="@color/colorPrimary"
            app:tabTextColor="@color/colorTextSecondary">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đang diễn ra" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lịch sử phiên" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hóa đơn" />
        </com.google.android.material.tabs.TabLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="80dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Active Dining Session Container -->
            <FrameLayout
                android:id="@+id/containerActiveSession"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Empty state when no active session -->
            <LinearLayout
                android:id="@+id/layoutEmptyOngoing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="60dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progressHistoryInvoices"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/ivHistoryEmptyIcon"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/bg_badge"
                    android:backgroundTint="#F5F5F5"
                    android:padding="16dp"
                    android:src="@drawable/ic_cutlery"
                    app:tint="@color/colorTextSecondary" />

                <TextView
                    android:id="@+id/tvHistoryEmptyMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Không có bàn ăn nào đang hoạt động"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Hãy quét mã QR tại bàn khi bạn đến nhà hàng để bắt đầu gọi món."
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEmptyScanQr"
                    style="@style/Widget.VietTable.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Quét mã QR tại bàn" />
            </LinearLayout>

            <!-- Past orders list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPastOrders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />

            <!-- Empty state for past orders -->
            <LinearLayout
                android:id="@+id/layoutEmptyPast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="60dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/bg_badge"
                    android:backgroundTint="#F5F5F5"
                    android:padding="16dp"
                    android:src="@drawable/ic_card"
                    app:tint="@color/colorTextSecondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Chưa có lịch sử phiên dùng bữa"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="16sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRetryHistoryInvoices"
                    style="@style/Widget.VietTable.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Thử tải lại"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
