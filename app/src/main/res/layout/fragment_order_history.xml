<?xml version="1.0" encoding="utf-8"?>
<!-- Đơn hàng "Phố đêm" (DESIGN_PHO_DEM.md section 6 "Tiến độ món / Đơn hiện tại", "Hóa đơn / Lịch sử hóa đơn"):
     big title, chip tabs, active table card, session / invoice cards, line-icon empty states with a ghost retry.
     Written from scratch; view IDs used by OrderHistoryFragment are kept. Bottom padding clears the floating nav. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pd_bg">

    <View
        android:layout_width="440dp"
        android:layout_height="440dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-200dp"
        android:layout_marginEnd="-200dp"
        android:background="@drawable/pd_glow_red"
        android:importantForAccessibility="no" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:tag="safe_top">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingBottom="140dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/pd_screen_margin"
                android:text="BỮA ĂN CỦA BẠN"
                android:textAppearance="@style/TextAppearance.VietTable.Label"
                android:textColor="@color/pd_yellow" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/pd_screen_margin"
                android:layout_marginTop="8dp"
                android:accessibilityHeading="true"
                android:text="Đơn hàng"
                android:textAppearance="@style/TextAppearance.VietTable.Display.XL" />

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayoutOrderHistory"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="18dp"
                android:clipToPadding="false"
                android:paddingHorizontal="18dp"
                app:tabMode="scrollable">

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Đang diễn ra" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lịch sử phiên" />

                <com.google.android.material.tabs.TabItem
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hóa đơn" />
            </com.google.android.material.tabs.TabLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/pd_screen_margin"
                android:paddingTop="16dp">

                <FrameLayout
                    android:id="@+id/containerActiveSession"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:id="@+id/layoutEmptyOngoing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:background="@drawable/pd_circle_surface2"
                        android:importantForAccessibility="no"
                        android:padding="26dp"
                        android:src="@drawable/ic_cutlery"
                        app:tint="@color/pd_dim" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center"
                        android:text="Không có bàn ăn nào đang hoạt động"
                        android:textAppearance="@style/TextAppearance.VietTable.Display.M" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="Hãy quét mã QR tại bàn khi bạn đến nhà hàng để bắt đầu gọi món."
                        android:textAppearance="@style/TextAppearance.VietTable.Body"
                        android:textColor="@color/pd_muted" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEmptyScanQr"
                        style="@style/Widget.VietTable.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="56dp"
                        android:layout_marginTop="20dp"
                        android:text="Quét mã QR tại bàn"
                        app:icon="@drawable/ic_qr_scan"
                        app:iconGravity="textStart" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPastOrders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/layoutEmptyPast"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/progressHistoryInvoices"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:visibility="gone"
                        app:indicatorColor="@color/pd_yellow" />

                    <ImageView
                        android:id="@+id/ivHistoryEmptyIcon"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:background="@drawable/pd_circle_surface2"
                        android:importantForAccessibility="no"
                        android:padding="26dp"
                        android:src="@drawable/ic_card"
                        app:tint="@color/pd_dim" />

                    <TextView
                        android:id="@+id/tvHistoryEmptyMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center"
                        android:text="Chưa có lịch sử phiên dùng bữa"
                        android:textAppearance="@style/TextAppearance.VietTable.Body"
                        android:textColor="@color/pd_muted" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRetryHistoryInvoices"
                        style="@style/Widget.VietTable.Button.Ghost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Thử tải lại"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
