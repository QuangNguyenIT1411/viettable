<?xml version="1.0" encoding="utf-8"?>
<!-- Chi tiết đơn "Phố đêm" (DESIGN_PHO_DEM.md sections 5–6): label, "Đơn #…" Display.XL, status pill, meta line,
     dish rows (item_tracked_food, same as Tiến độ món), total card in yellow, bottom yellow button over a fade.
     Written from scratch; view IDs used by OrderDetailFragment are kept (the toolbar is now a round back button). -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pd_bg">

    <View
        android:layout_width="440dp"
        android:layout_height="440dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-200dp"
        android:layout_marginEnd="-200dp"
        android:background="@drawable/pd_glow_yellow"
        android:importantForAccessibility="no" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:tag="safe_top">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/pd_screen_margin"
            android:paddingTop="12dp"
            android:paddingBottom="128dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/pd_circle_surface2"
                android:contentDescription="@string/a11y_back"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_back"
                app:tint="@color/pd_cream" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="CHI TIẾT ĐỢT GỌI MÓN"
                android:textAppearance="@style/TextAppearance.VietTable.Label"
                android:textColor="@color/pd_yellow" />

            <TextView
                android:id="@+id/tvOrderDetailId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityHeading="true"
                android:textAppearance="@style/TextAppearance.VietTable.Display.XL"
                tools:text="Đơn #38" />

            <TextView
                android:id="@+id/tvOrderDetailStatus"
                style="@style/Widget.VietTable.StatusPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                tools:text="ĐANG XỬ LÝ" />

            <TextView
                android:id="@+id/tvOrderDetailMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textAppearance="@style/TextAppearance.VietTable.Body"
                android:textColor="@color/pd_muted"
                tools:text="Bàn B4 • Gọi lúc: 18:50, 27/10/2026 • Chi nhánh Quận 1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Các món trong đợt này"
                android:textAppearance="@style/TextAppearance.VietTable.Display.M" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvOrderItemsDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/pd_card_surface"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="22dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tổng đợt gọi này"
                    android:textAppearance="@style/TextAppearance.VietTable.Body.Strong" />

                <TextView
                    android:id="@+id/tvOrderSubtotalPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:textAppearance="@style/TextAppearance.VietTable.Price"
                    android:textColor="@color/pd_yellow"
                    tools:text="194.000đ" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/pd_fade_bottom"
        android:paddingHorizontal="@dimen/pd_screen_margin"
        android:paddingTop="28dp"
        android:paddingBottom="16dp"
        android:tag="safe_bottom">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewProgressFromDetail"
            style="@style/Widget.VietTable.Button.Primary.Arrow"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Theo dõi tiến độ món" />
    </FrameLayout>
</FrameLayout>
