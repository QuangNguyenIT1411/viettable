<?xml version="1.0" encoding="utf-8"?>
<!-- Thẻ thành viên "Phố đêm" (DESIGN_PHO_DEM.md section 6): plum member card with tier, points, holder and card
     number, tier progress (red→yellow bar, only from the server's real numbers), tier benefits. Written from scratch;
     view IDs used by LoyaltyFragment are kept (the toolbar is now a round back button). -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pd_bg">

    <View
        android:layout_width="440dp"
        android:layout_height="440dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-200dp"
        android:layout_marginEnd="-200dp"
        android:background="@drawable/pd_glow_yellow"
        android:importantForAccessibility="no" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/pd_screen_margin"
            android:paddingTop="12dp"
            android:paddingBottom="32dp"
            android:tag="safe_all">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/pd_circle_surface2"
                android:contentDescription="@string/a11y_back"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_back"
                app:tint="@color/pd_cream" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="VIETTABLE CLUB"
                android:textAppearance="@style/TextAppearance.VietTable.Label"
                android:textColor="@color/pd_yellow" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityHeading="true"
                android:text="Hạng thẻ &amp; Điểm thưởng"
                android:textAppearance="@style/TextAppearance.VietTable.Display.XL" />

            <!-- Member card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.VietTable.Card.Plum"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:minHeight="200dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <View
                        android:layout_width="260dp"
                        android:layout_height="260dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="-110dp"
                        android:layout_marginEnd="-90dp"
                        android:background="@drawable/pd_glow_yellow"
                        android:importantForAccessibility="no" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:alpha="0.6"
                        android:background="@drawable/pd_stripes"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="THẺ THÀNH VIÊN"
                                android:textAppearance="@style/TextAppearance.VietTable.Label"
                                android:textColor="@color/pd_muted" />

                            <TextView
                                android:id="@+id/tvCardTier"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_status_chip"
                                android:backgroundTint="@color/pd_yellow"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="5dp"
                                android:textAppearance="@style/TextAppearance.VietTable.Label"
                                android:textColor="@color/pd_on_color"
                                tools:text="VÀNG" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="28dp"
                            android:text="Điểm khả dụng"
                            android:textAppearance="@style/TextAppearance.VietTable.Caption"
                            android:textColor="@color/pd_muted" />

                        <TextView
                            android:id="@+id/tvCardPoints"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textAppearance="@style/TextAppearance.VietTable.Display.XL"
                            android:textColor="@color/pd_yellow"
                            tools:text="3.250 pts" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:gravity="bottom"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvCardHolder"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textAppearance="@style/TextAppearance.VietTable.Body.Strong"
                                tools:text="NGUYỄN VINH QUANG" />

                            <TextView
                                android:id="@+id/tvCardNumber"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:textAppearance="@style/TextAppearance.VietTable.Label"
                                android:textColor="@color/pd_muted"
                                tools:text="VT 0001 2345" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tier progress: filled from GET /me/loyalty; hidden until it loads or at the top tier. -->
            <LinearLayout
                android:id="@+id/cardTierProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/pd_card_surface"
                android:orientation="vertical"
                android:padding="22dp"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvTierProgressTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.VietTable.Display.M"
                        tools:text="Tiến độ lên hạng Kim cương" />

                    <TextView
                        android:id="@+id/tvTierProgressPoints"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:textAppearance="@style/TextAppearance.VietTable.Body.Strong"
                        android:textColor="@color/pd_yellow"
                        tools:text="3.250 / 5.000" />
                </LinearLayout>

                <com.restaurant.viettable.ui.common.PdProgressBar
                    android:id="@+id/progressTier"
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:layout_marginTop="16dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/tvTierProgressHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textAppearance="@style/TextAppearance.VietTable.Caption"
                    android:textColor="@color/pd_muted"
                    tools:text="Tích lũy thêm 1.750 điểm để lên hạng Kim cương." />
            </LinearLayout>

            <!-- Tier benefits: the real list from GET /me/loyalty; hidden until it loads. -->
            <TextView
                android:id="@+id/tvBenefitsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:textAppearance="@style/TextAppearance.VietTable.Display.M"
                android:visibility="gone"
                tools:text="Đặc quyền hạng Vàng"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/cardBenefits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/pd_card_surface"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:id="@+id/layoutBenefits"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
