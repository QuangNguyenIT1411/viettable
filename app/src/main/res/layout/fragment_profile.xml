<?xml version="1.0" encoding="utf-8"?>
<!-- Tôi "Phố đêm" (DESIGN_PHO_DEM.md section 6 "Tôi / Hồ sơ / Thẻ thành viên / Cài đặt"): profile header, plum member
     card (real tier and points from ProfileFragment), surface rows with round icons, yellow switch, red logout.
     Written from scratch; view IDs used by ProfileFragment are kept. Bottom padding clears the floating nav. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pd_bg">

    <View
        android:layout_width="440dp"
        android:layout_height="440dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-200dp"
        android:layout_marginEnd="-200dp"
        android:background="@drawable/pd_glow_red"
        android:importantForAccessibility="no" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="140dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/pd_screen_margin"
                android:paddingTop="20dp"
                android:tag="safe_top">

                <FrameLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/pd_plate"
                    android:padding="5dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/pd_circle_surface2"
                        android:importantForAccessibility="no"
                        android:padding="14dp"
                        android:src="@drawable/ic_profile"
                        app:tint="@color/pd_cream" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="TÀI KHOẢN"
                        android:textAppearance="@style/TextAppearance.VietTable.Label"
                        android:textColor="@color/pd_yellow" />

                    <TextView
                        android:id="@+id/tvProfileName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:accessibilityHeading="true"
                        android:textAppearance="@style/TextAppearance.VietTable.Display.L"
                        tools:text="Nguyễn Vinh Quang" />

                    <TextView
                        android:id="@+id/tvProfilePhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.VietTable.Caption"
                        android:textColor="@color/pd_muted"
                        tools:text="0901 234 567" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnEditProfileHeader"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/pd_circle_surface2"
                    android:clickable="true"
                    android:contentDescription="@string/a11y_edit_profile"
                    android:focusable="true"
                    android:padding="13dp"
                    android:src="@drawable/ic_arrow_forward"
                    app:tint="@color/pd_cream" />
            </LinearLayout>

            <!-- Member card: plum, tier pill, points (real values from the code). -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProfileLoyalty"
                style="@style/Widget.VietTable.Card.Plum"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/pd_screen_margin"
                android:layout_marginTop="24dp"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <View
                        android:layout_width="220dp"
                        android:layout_height="220dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="-90dp"
                        android:layout_marginEnd="-80dp"
                        android:background="@drawable/pd_glow_yellow"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="22dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="THẺ THÀNH VIÊN"
                                android:textAppearance="@style/TextAppearance.VietTable.Label"
                                android:textColor="@color/pd_muted" />

                            <TextView
                                android:id="@+id/tvProfileTierBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_status_chip"
                                android:backgroundTint="@color/pd_yellow"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="5dp"
                                android:textAllCaps="true"
                                android:textAppearance="@style/TextAppearance.VietTable.Label"
                                android:textColor="@color/pd_on_color"
                                tools:text="Hạng Vàng" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="Điểm tích lũy hiện có"
                            android:textAppearance="@style/TextAppearance.VietTable.Caption"
                            android:textColor="@color/pd_muted" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvProfilePoints"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textAppearance="@style/TextAppearance.VietTable.Display.L"
                                android:textColor="@color/pd_yellow"
                                tools:text="3.250 điểm" />

                            <ImageView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_marginStart="8dp"
                                android:contentDescription="Xem thẻ thành viên"
                                android:src="@drawable/pd_btn_arrow_ghost" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <FrameLayout
                android:id="@+id/containerProfileActiveDining"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/pd_screen_margin"
                android:layout_marginTop="14dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/pd_screen_margin"
                android:layout_marginTop="28dp"
                android:text="TÀI KHOẢN"
                android:textAppearance="@style/TextAppearance.VietTable.Label"
                android:textColor="@color/pd_muted" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/pd_screen_margin"
                android:layout_marginTop="2dp"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/rowEditProfile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/pd_row_surface"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="64dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="10dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/pd_circle_yellow"
                        android:importantForAccessibility="no"
                        android:padding="10dp"
                        android:src="@drawable/ic_profile"
                        app:tint="@color/pd_on_color" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="Thông tin cá nhân"
                        android:textAppearance="@style/TextAppearance.VietTable.Body.Strong" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="@color/pd_dim" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowResHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/pd_row_surface"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="64dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="10dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/pd_circle_surface2"
                        android:importantForAccessibility="no"
                        android:padding="10dp"
                        android:src="@drawable/ic_reservation"
                        app:tint="@color/pd_cream" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="Lịch sử đặt bàn"
                        android:textAppearance="@style/TextAppearance.VietTable.Body.Strong" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="@color/pd_dim" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowOrderHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/pd_row_surface"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="64dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="10dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/pd_circle_surface2"
                        android:importantForAccessibility="no"
                        android:padding="10dp"
                        android:src="@drawable/ic_orders"
                        app:tint="@color/pd_cream" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="Lịch sử phiên và hóa đơn"
                        android:textAppearance="@style/TextAppearance.VietTable.Body.Strong" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="@color/pd_dim" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowReviews"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/pd_row_surface"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="64dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="10dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/pd_circle_surface2"
                        android:importantForAccessibility="no"
                        android:padding="10dp"
                        android:src="@drawable/ic_star"
                        app:tint="@color/pd_cream" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="Đánh giá của tôi"
                        android:textAppearance="@style/TextAppearance.VietTable.Body.Strong" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="@color/pd_dim" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/pd_screen_margin"
                android:layout_marginTop="28dp"
                android:text="ƯU ĐÃI &amp; THÀNH VIÊN"
                android:textAppearance="@style/TextAppearance.VietTable.Label"
                android:textColor="@color/pd_muted" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/pd_screen_margin"
                android:layout_marginTop="2dp"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/rowVouchers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/pd_row_surface"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="64dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="10dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/pd_circle_plum"
                        android:importantForAccessibility="no"
                        android:padding="10dp"
                        android:src="@drawable/ic_voucher"
                        app:tint="@color/pd_yellow" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="Ưu đãi của tôi (Vouchers)"
                        android:textAppearance="@style/TextAppearance.VietTable.Body.Strong" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="@color/pd_dim" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/pd_screen_margin"
                android:layout_marginTop="28dp"
                android:text="HỆ THỐNG"
                android:textAppearance="@style/TextAppearance.VietTable.Label"
                android:textColor="@color/pd_muted" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/pd_screen_margin"
                android:layout_marginTop="2dp"
                android:orientation="vertical">

                <!-- Fingerprint login (hidden on phones without an enrolled strong fingerprint). -->
                <LinearLayout
                    android:id="@+id/rowBiometricLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/pd_row_surface"
                    android:gravity="center_vertical"
                    android:minHeight="64dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="10dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/pd_circle_surface2"
                        android:importantForAccessibility="no"
                        android:padding="10dp"
                        android:src="@drawable/ic_fingerprint"
                        app:tint="@color/pd_cream" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="Đăng nhập bằng vân tay"
                        android:textAppearance="@style/TextAppearance.VietTable.Body.Strong" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchBiometricLogin"
                        style="@style/Widget.VietTable.Switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:saveEnabled="false" />
                </LinearLayout>

                <!-- Kept for ProfileFragment (shown with the fingerprint row); rows are separate cards now. -->
                <View
                    android:id="@+id/dividerBiometricLogin"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/rowSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/pd_row_surface"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="64dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="10dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/pd_circle_surface2"
                        android:importantForAccessibility="no"
                        android:padding="10dp"
                        android:src="@drawable/ic_info"
                        app:tint="@color/pd_cream" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="Cài đặt ứng dụng"
                        android:textAppearance="@style/TextAppearance.VietTable.Body.Strong" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="@color/pd_dim" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowSupport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/pd_row_surface"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="64dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="10dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/pd_circle_surface2"
                        android:importantForAccessibility="no"
                        android:padding="10dp"
                        android:src="@drawable/ic_phone"
                        app:tint="@color/pd_cream" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="Hỗ trợ &amp; Trợ giúp"
                        android:textAppearance="@style/TextAppearance.VietTable.Body.Strong" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="@color/pd_dim" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                style="@style/Widget.VietTable.Button.Red"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginHorizontal="@dimen/pd_screen_margin"
                android:layout_marginTop="28dp"
                android:text="Đăng xuất tài khoản" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
