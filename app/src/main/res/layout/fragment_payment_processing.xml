<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp"
    android:tag="safe_all">

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progressPayment"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:indeterminate="true"
        app:indicatorColor="@color/colorPrimary"
        app:indicatorSize="64dp"
        app:trackColor="@color/colorDivider"
        app:trackThickness="6dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="sans-serif-medium"
        android:text="Đang xử lý giao dịch..."
        android:textColor="@color/colorTextPrimary"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/tvProcessingMethod"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Kết nối cổng VietQR / Napas"
        android:textColor="@color/colorTextSecondary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvProcessingAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_badge"
        android:backgroundTint="#E8F5E9"
        android:fontFamily="sans-serif-medium"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text="--"
        android:textColor="@color/colorPrimary"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tvProviderReference"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/colorTextSecondary"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvProviderExpiry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/colorTextSecondary"
        android:textSize="13sp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOpenProvider"
        style="@style/Widget.VietTable.Button.Primary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Mở VNPAY Sandbox"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRefreshPaymentStatus"
        style="@style/Widget.VietTable.Button.Secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Kiểm tra trạng thái" />

</LinearLayout>
