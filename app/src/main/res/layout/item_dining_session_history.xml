<?xml version="1.0" encoding="utf-8"?>
<!-- Past dining session "Phố đêm": session label, branch, times, status line + yellow total, its order rounds on
     surface_2 inside. View IDs used by DiningSessionHistoryAdapter are kept. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.VietTable.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvHistorySessionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAllCaps="true"
            android:textAppearance="@style/TextAppearance.VietTable.Label"
            android:textColor="@color/pd_yellow"
            tools:text="Phiên #20 • Bàn B4" />

        <TextView
            android:id="@+id/tvHistorySessionBranch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="@style/TextAppearance.VietTable.Display.M"
            tools:text="Chi nhánh Quận 1" />

        <TextView
            android:id="@+id/tvHistorySessionTimes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.VietTable.Caption"
            android:textColor="@color/pd_muted"
            tools:text="Bắt đầu: 26/10 19:02 • Kết thúc: 26/10 20:40" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvHistorySessionStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.VietTable.Body"
                android:textColor="@color/pd_muted"
                tools:text="Đã đóng • 2 đợt gọi món" />

            <TextView
                android:id="@+id/tvHistorySessionTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textAppearance="@style/TextAppearance.VietTable.Price"
                android:textColor="@color/pd_yellow"
                tools:text="272.500đ" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHistoryRounds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:nestedScrollingEnabled="false" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
