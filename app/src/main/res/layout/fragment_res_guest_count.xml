<?xml version="1.0" encoding="utf-8"?>
<!-- Đặt bàn bước 3 "Phố đêm": big steppers for adults and children (DESIGN_PHO_DEM.md section 5 "Bộ đếm").
     Written from scratch; view IDs used by ResGuestCountFragment are kept. The deposit note comes from the server's
     deposit policy (hidden when the feature is off). -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pd_bg">

    <View
        android:layout_width="440dp"
        android:layout_height="440dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-200dp"
        android:layout_marginEnd="-200dp"
        android:background="@drawable/pd_glow_yellow"
        android:importantForAccessibility="no" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:tag="safe_top">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="140dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="@dimen/pd_screen_margin"
                android:background="@drawable/pd_circle_surface2"
                android:contentDescription="@string/a11y_back"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_back"
                app:tint="@color/pd_cream" />

            <TextView
                android:id="@+id/tvDateTimeSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/pd_screen_margin"
                android:layout_marginTop="28dp"
                android:textAllCaps="true"
                android:textAppearance="@style/TextAppearance.VietTable.Label"
                tools:text="Thời gian: 19:00 • 27/10/2026" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/pd_screen_margin"
                android:layout_marginTop="8dp"
                android:accessibilityHeading="true"
                android:text="Số lượng khách"
                android:textAppearance="@style/TextAppearance.VietTable.Display.XL" />

            <include
                android:id="@+id/wizardProgress"
                layout="@layout/view_wizard_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp" />

            <!-- Adults -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/pd_screen_margin"
                android:layout_marginTop="24dp"
                android:background="@drawable/pd_card_surface"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Người lớn"
                        android:textAppearance="@style/TextAppearance.VietTable.Display.M" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Từ 12 tuổi trở lên"
                        android:textAppearance="@style/TextAppearance.VietTable.Caption"
                        android:textColor="@color/pd_muted" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/pd_stepper_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp">

                    <ImageButton
                        android:id="@+id/btnMinusAdult"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/pd_circle_surface"
                        android:contentDescription="@string/a11y_decrease"
                        android:padding="11dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_remove"
                        app:tint="@color/pd_cream" />

                    <TextView
                        android:id="@+id/tvAdultCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:minWidth="40dp"
                        android:textAppearance="@style/TextAppearance.VietTable.Price"
                        tools:text="4" />

                    <ImageButton
                        android:id="@+id/btnPlusAdult"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/pd_circle_cream"
                        android:contentDescription="@string/a11y_increase"
                        android:padding="11dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_add"
                        app:tint="@color/pd_on_color" />
                </LinearLayout>
            </LinearLayout>

            <!-- Children -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/pd_screen_margin"
                android:layout_marginTop="14dp"
                android:background="@drawable/pd_card_surface"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Trẻ em"
                        android:textAppearance="@style/TextAppearance.VietTable.Display.M" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Dưới 12 tuổi (hỗ trợ ghế trẻ em)"
                        android:textAppearance="@style/TextAppearance.VietTable.Caption"
                        android:textColor="@color/pd_muted" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/pd_stepper_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp">

                    <ImageButton
                        android:id="@+id/btnMinusChild"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/pd_circle_surface"
                        android:contentDescription="@string/a11y_decrease"
                        android:padding="11dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_remove"
                        app:tint="@color/pd_cream" />

                    <TextView
                        android:id="@+id/tvChildCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:minWidth="40dp"
                        android:textAppearance="@style/TextAppearance.VietTable.Price"
                        tools:text="0" />

                    <ImageButton
                        android:id="@+id/btnPlusChild"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/pd_circle_cream"
                        android:contentDescription="@string/a11y_increase"
                        android:padding="11dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_add"
                        app:tint="@color/pd_on_color" />
                </LinearLayout>
            </LinearLayout>

            <!-- Policy note for large groups -->
            <LinearLayout
                android:id="@+id/layoutDepositNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/pd_screen_margin"
                android:layout_marginTop="16dp"
                android:background="@drawable/pd_card_yellow_soft"
                android:orientation="horizontal"
                android:padding="16dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_warning"
                    app:tint="@color/pd_yellow" />

                <TextView
                    android:id="@+id/tvDepositNotice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    tools:text="Từ 6 khách cần đặt cọc 50.000đ/khách: 300.000đ, chuyển khoản VietQR trong 15 phút để giữ bàn."
                    android:textAppearance="@style/TextAppearance.VietTable.Caption"
                    android:textColor="@color/pd_cream" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/pd_fade_bottom"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/pd_screen_margin"
        android:paddingTop="28dp"
        android:paddingBottom="16dp"
        android:tag="safe_bottom">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinue"
            style="@style/Widget.VietTable.Button.Primary.Arrow"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="@string/btn_continue" />
    </LinearLayout>
</FrameLayout>
