<?xml version="1.0" encoding="utf-8"?>
<!-- Giỏ hàng tại bàn "Phố đêm" (DESIGN_PHO_DEM.md section 6 "Giỏ hàng"): cart rows, kitchen note, yellow total,
     yellow "Gửi bếp" button. Written from scratch; view IDs used by DineinCartFragment are kept (the toolbar is now a
     round back button). -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pd_bg">

    <View
        android:layout_width="420dp"
        android:layout_height="420dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-200dp"
        android:layout_marginEnd="-190dp"
        android:background="@drawable/pd_glow_yellow"
        android:importantForAccessibility="no" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:tag="safe_top">

        <LinearLayout
            android:id="@+id/layoutDineinCartContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/pd_screen_margin"
            android:paddingTop="12dp"
            android:paddingBottom="140dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/pd_circle_surface2"
                    android:contentDescription="@string/a11y_back"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_back"
                    app:tint="@color/pd_cream" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/btnClearDineinCart"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/pd_chip_idle"
                    android:gravity="center"
                    android:minHeight="48dp"
                    android:paddingHorizontal="18dp"
                    android:text="Xóa giỏ"
                    android:textAppearance="@style/TextAppearance.VietTable.Caption"
                    android:textColor="@color/pd_red" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDineinCartTable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:textAllCaps="true"
                android:textAppearance="@style/TextAppearance.VietTable.Label"
                android:textColor="@color/pd_mint"
                tools:text="Gửi tới: Bàn B4 • Chi nhánh Quận 1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityHeading="true"
                android:text="@string/pd_cart_title"
                android:textAppearance="@style/TextAppearance.VietTable.Display.XL" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Danh sách món gọi thêm"
                android:textAppearance="@style/TextAppearance.VietTable.Display.M" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvDineinCartItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/pd_cart_note_label"
                android:textAppearance="@style/TextAppearance.VietTable.Label" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilKitchenNote"
                style="@style/Widget.VietTable.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="Ghi chú chung cho toàn bộ đơn này (tùy chọn)">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etKitchenNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine"
                    android:minLines="2" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/pd_card_surface"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tạm tính đợt gọi này"
                    android:textAppearance="@style/TextAppearance.VietTable.Body"
                    android:textColor="@color/pd_muted" />

                <TextView
                    android:id="@+id/tvDineinCartTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:textAppearance="@style/TextAppearance.VietTable.Price"
                    android:textColor="@color/pd_yellow"
                    android:textSize="22sp"
                    tools:text="130.000đ" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/pd_fade_bottom"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/pd_screen_margin"
        android:paddingTop="28dp"
        android:paddingBottom="16dp"
        android:tag="safe_bottom">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitDineinOrder"
            style="@style/Widget.VietTable.Button.Primary.Arrow"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Gửi đơn gọi món tới Bếp" />
    </LinearLayout>
</FrameLayout>
