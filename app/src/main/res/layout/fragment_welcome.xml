<?xml version="1.0" encoding="utf-8"?>
<!-- Chào mừng "Phố đêm" (design P01). Written from scratch; IDs used by WelcomeFragment are kept.
     The decorative plates are the app's bundled dish photos; no price sticker (it would be a made-up number). -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pd_bg">

    <View
        android:layout_width="520dp"
        android:layout_height="520dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="40dp"
        android:background="@drawable/pd_glow_yellow"
        android:importantForAccessibility="no" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:tag="safe_all">

        <LinearLayout
            android:id="@+id/layoutCenterBrand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/pd_screen_margin"
            android:paddingBottom="24dp">

            <!-- Plates: one big, two small ones overlapping it. -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="24dp"
                android:clipChildren="false">

                <FrameLayout
                    android:id="@+id/plateWelcomeMain"
                    android:layout_width="230dp"
                    android:layout_height="230dp"
                    android:layout_gravity="center"
                    android:background="@drawable/pd_plate"
                    android:elevation="14dp"
                    android:outlineSpotShadowColor="@color/black"
                    android:padding="22dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivWelcomeLogo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/app_name"
                        android:scaleType="centerCrop"
                        android:src="@drawable/food_bun_cha"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.VietTable.Circle" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/plateWelcomeA"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:layout_gravity="top|start"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/pd_plate"
                    android:elevation="18dp"
                    android:outlineSpotShadowColor="@color/black"
                    android:padding="8dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop"
                        android:src="@drawable/food_che_khuc_bach"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.VietTable.Circle" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/plateWelcomeB"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/pd_plate"
                    android:elevation="18dp"
                    android:outlineSpotShadowColor="@color/black"
                    android:padding="9dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop"
                        android:src="@drawable/food_goi_cuon"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.VietTable.Circle" />
                </FrameLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/tvWelcomeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:accessibilityHeading="true"
                android:text="@string/pd_welcome_title"
                android:textAppearance="@style/TextAppearance.VietTable.Display.XL"
                android:textSize="48sp"
                app:lineHeight="52sp" />

            <TextView
                android:id="@+id/tvWelcomeSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/pd_welcome_sub"
                android:textAppearance="@style/TextAppearance.VietTable.Body"
                android:textColor="@color/pd_muted" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="24dp" />

            <LinearLayout
                android:id="@+id/layoutBottomActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogin"
                    style="@style/Widget.VietTable.Button.Primary.Arrow"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="@string/auth_login" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRegister"
                    style="@style/Widget.VietTable.Button.Ghost.Arrow"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/auth_register" />

                <TextView
                    android:id="@+id/btnSkipAuth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:minHeight="48dp"
                    android:paddingHorizontal="12dp"
                    android:text="@string/pd_welcome_skip"
                    android:textAppearance="@style/TextAppearance.VietTable.Body.Strong"
                    android:textColor="@color/pd_yellow" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
