<?xml version="1.0" encoding="utf-8"?>
<!-- Scan bar that runs up and down over the QR: yellow glow fading upward, orange line at the bottom edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#80FFC53D"
                android:endColor="#00FFC53D" />
        </shape>
    </item>
    <item android:gravity="bottom" android:height="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/pd_red" />
        </shape>
    </item>
</layer-list>
