<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- "Phố đêm": always dark, whatever the system light/dark setting (DESIGN_PHO_DEM.md section 8). -->
    <style name="Base.Theme.VietTable" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/pd_yellow</item>
        <item name="colorPrimaryDark">@color/pd_bg</item>
        <item name="colorOnPrimary">@color/pd_on_color</item>
        <item name="colorPrimaryContainer">@color/pd_surface_2</item>
        <item name="colorOnPrimaryContainer">@color/pd_yellow</item>
        <item name="colorPrimaryInverse">@color/pd_yellow</item>

        <item name="colorSecondary">@color/pd_yellow</item>
        <item name="colorOnSecondary">@color/pd_on_color</item>
        <item name="colorSecondaryContainer">@color/pd_surface_2</item>
        <item name="colorOnSecondaryContainer">@color/pd_cream</item>

        <item name="colorTertiary">@color/pd_mint</item>
        <item name="colorOnTertiary">@color/pd_on_color</item>

        <item name="android:colorBackground">@color/pd_bg</item>
        <item name="colorOnBackground">@color/pd_cream</item>
        <item name="colorSurface">@color/pd_surface</item>
        <item name="colorOnSurface">@color/pd_cream</item>
        <item name="colorSurfaceVariant">@color/pd_surface_2</item>
        <item name="colorOnSurfaceVariant">@color/pd_muted</item>
        <item name="colorSurfaceInverse">@color/pd_cream</item>
        <item name="colorOnSurfaceInverse">@color/pd_on_color</item>
        <item name="colorSurfaceContainerLowest">@color/pd_bg</item>
        <item name="colorSurfaceContainerLow">@color/pd_surface</item>
        <item name="colorSurfaceContainer">@color/pd_surface</item>
        <item name="colorSurfaceContainerHigh">@color/pd_surface_2</item>
        <item name="colorSurfaceContainerHighest">@color/pd_surface_2</item>
        <item name="colorOutline">@color/pd_line</item>
        <item name="colorOutlineVariant">@color/pd_line</item>

        <item name="colorError">@color/pd_red</item>
        <item name="colorOnError">@color/pd_on_color</item>

        <item name="android:textColorPrimary">@color/pd_cream</item>
        <item name="android:textColorSecondary">@color/pd_muted</item>
        <item name="android:textColorHint">@color/pd_dim</item>
        <item name="android:textColorLink">@color/pd_yellow</item>
        <item name="android:textColorHighlight">#66FFC53D</item>
        <item name="colorControlNormal">@color/pd_muted</item>
        <item name="colorControlActivated">@color/pd_yellow</item>
        <item name="colorControlHighlight">@color/pd_ripple</item>
        <item name="colorAccent">@color/pd_yellow</item>

        <!-- Text: Bricolage for plain text views (a theme-level fontFamily would override every widget's textAppearance). -->
        <item name="android:textViewStyle">@style/Widget.VietTable.TextView</item>
        <item name="editTextStyle">@style/Widget.VietTable.EditText</item>
        <item name="android:editTextStyle">@style/Widget.VietTable.EditText</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.VietTable.M3.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.VietTable.M3.Body</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.VietTable.M3.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.VietTable.M3.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.VietTable.M3.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.VietTable.M3.LabelSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.VietTable.M3.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.VietTable.M3.Title</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.VietTable.M3.LabelLarge</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.VietTable.M3.Headline</item>

        <!-- System bars: page colour behind them, light icons. -->
        <item name="android:windowBackground">@color/pd_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- Material Components default style overrides -->
        <item name="alertDialogTheme">@style/ThemeOverlay.VietTable.Dialog.Alert</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.VietTable.MaterialAlertDialog</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.VietTable.Dialog.Button.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.VietTable.Dialog.Button.Negative</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.VietTable.Dialog.Button.Neutral</item>
        <item name="materialButtonStyle">@style/Widget.VietTable.Button.Primary</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.VietTable.Button.Outlined</item>
        <item name="borderlessButtonStyle">@style/Widget.VietTable.Button.Text</item>
        <item name="materialCardViewStyle">@style/Widget.VietTable.Card</item>
        <item name="textInputStyle">@style/Widget.VietTable.TextInputLayout</item>
        <item name="toolbarStyle">@style/Widget.VietTable.Toolbar</item>
        <item name="bottomNavigationStyle">@style/Widget.VietTable.BottomNavigationView</item>
        <item name="chipStyle">@style/Widget.VietTable.Chip.Filter</item>
        <item name="tabStyle">@style/Widget.VietTable.TabLayout</item>
        <item name="switchStyle">@style/Widget.VietTable.Switch</item>
        <item name="snackbarStyle">@style/Widget.VietTable.Snackbar</item>
        <item name="snackbarTextViewStyle">@style/Widget.VietTable.Snackbar.Text</item>
        <item name="snackbarButtonStyle">@style/Widget.VietTable.Snackbar.Button</item>
    </style>

    <style name="Theme.VietTable" parent="Base.Theme.VietTable" />
</resources>
