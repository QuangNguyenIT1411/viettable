<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Typography Styles -->
    <style name="TextAppearance.VietTable.Display" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.VietTable.H1" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">@dimen/text_h1</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.VietTable.H2" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">@dimen/text_h2</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.VietTable.H3" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/text_h3</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.VietTable.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.VietTable.Subtitle" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.VietTable.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="TextAppearance.VietTable.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/text_body_small</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.VietTable.Caption" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>

    <style name="TextAppearance.VietTable.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Button Styles -->
    <style name="Widget.VietTable.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/selector_btn_primary_bg</item>
        <item name="android:backgroundTint">@color/selector_btn_primary_bg</item>
        <item name="android:textColor">@color/selector_btn_primary_text</item>
        <item name="android:minHeight">@dimen/btn_height_primary</item>
        <item name="cornerRadius">@dimen/radius_medium</item>
        <item name="android:textAppearance">@style/TextAppearance.VietTable.Button</item>
    </style>

    <style name="Widget.VietTable.Button.Secondary" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/selector_btn_secondary_bg</item>
        <item name="android:backgroundTint">@color/selector_btn_secondary_bg</item>
        <item name="android:textColor">@color/selector_btn_secondary_text</item>
        <item name="android:minHeight">@dimen/btn_height_primary</item>
        <item name="cornerRadius">@dimen/radius_medium</item>
        <item name="android:textAppearance">@style/TextAppearance.VietTable.Button</item>
    </style>

    <style name="Widget.VietTable.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:backgroundTint">@android:color/transparent</item>
        <item name="android:textColor">@color/primary</item>
        <item name="strokeColor">@color/primary</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:minHeight">@dimen/btn_height_primary</item>
        <item name="cornerRadius">@dimen/radius_medium</item>
        <item name="android:textAppearance">@style/TextAppearance.VietTable.Button</item>
    </style>

    <style name="Widget.VietTable.Button.OutlinedLight" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">#FFFFFFFF</item>
        <item name="android:backgroundTint">#FFFFFFFF</item>
        <item name="android:textColor">@color/primary</item>
        <item name="strokeColor">@color/primary</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:minHeight">@dimen/btn_height_primary</item>
        <item name="cornerRadius">@dimen/radius_medium</item>
        <item name="android:textAppearance">@style/TextAppearance.VietTable.Button</item>
    </style>

    <style name="Widget.VietTable.Button.Gold" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/selector_btn_gold_bg</item>
        <item name="android:backgroundTint">@color/selector_btn_gold_bg</item>
        <item name="android:textColor">@color/gold_btn_text</item>
        <item name="android:minHeight">@dimen/btn_height_primary</item>
        <item name="cornerRadius">@dimen/radius_medium</item>
        <item name="android:textAppearance">@style/TextAppearance.VietTable.Button</item>
    </style>

    <style name="Widget.VietTable.Button.Destructive" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/selector_btn_destructive_bg</item>
        <item name="android:backgroundTint">@color/selector_btn_destructive_bg</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:minHeight">@dimen/btn_height_primary</item>
        <item name="cornerRadius">@dimen/radius_medium</item>
        <item name="android:textAppearance">@style/TextAppearance.VietTable.Button</item>
    </style>

    <style name="Widget.VietTable.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:backgroundTint">@android:color/transparent</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textAppearance">@style/TextAppearance.VietTable.Button</item>
    </style>

    <!-- Card Styles -->
    <style name="Widget.VietTable.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/radius_large</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">@dimen/card_stroke_width</item>
    </style>

    <style name="Widget.VietTable.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/radius_large</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">@dimen/card_stroke_width</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Widget.VietTable.Card.Gold" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/radius_large</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardBackgroundColor">@color/accent_gold_container</item>
        <item name="strokeColor">@color/accent_gold</item>
        <item name="strokeWidth">@dimen/card_stroke_width</item>
    </style>

    <style name="Widget.VietTable.Card.ActiveDining" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/radius_large</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/primary_container</item>
        <item name="strokeColor">#BEE0CF</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Toolbar Style -->
    <style name="Widget.VietTable.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/surface</item>
        <item name="titleTextColor">@color/text_primary</item>
        <item name="subtitleTextColor">@color/text_secondary</item>
        <item name="navigationIconTint">@color/text_primary</item>
    </style>

    <style name="TextAppearance.VietTable.BottomNav.Label" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="TextAppearance.VietTable.BottomNav.Label.Active" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.VietTable.BottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/primary_container</item>
        <item name="android:width">56dp</item>
        <item name="android:height">32dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Full</item>
    </style>

    <!-- Bottom Navigation Style -->
    <style name="Widget.VietTable.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@drawable/bg_bottom_nav_floating</item>
        <item name="itemIconTint">@color/selector_bottom_nav</item>
        <item name="itemTextColor">@color/selector_bottom_nav</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.VietTable.BottomNav.ActiveIndicator</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.VietTable.BottomNav.Label</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.VietTable.BottomNav.Label.Active</item>
        <item name="itemRippleColor">@color/transparent</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="elevation">8dp</item>
    </style>

    <!-- Input Field Styles -->
    <style name="Widget.VietTable.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_medium</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_medium</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_medium</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_medium</item>
        <item name="boxStrokeColor">@color/primary</item>
        <item name="hintTextColor">@color/primary</item>
    </style>

    <!-- Dialog Button Styles -->
    <style name="Widget.VietTable.Dialog.Button.Positive" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/selector_dialog_btn_positive_text</item>
        <item name="android:backgroundTint">@color/transparent</item>
        <item name="backgroundTint">@color/transparent</item>
        <item name="rippleColor">@color/primary_container</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.VietTable.Dialog.Button.Negative" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/selector_dialog_btn_negative_text</item>
        <item name="android:backgroundTint">@color/transparent</item>
        <item name="backgroundTint">@color/transparent</item>
        <item name="rippleColor">@color/surface_variant</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="Widget.VietTable.Dialog.Button.Neutral" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/selector_dialog_btn_negative_text</item>
        <item name="android:backgroundTint">@color/transparent</item>
        <item name="backgroundTint">@color/transparent</item>
        <item name="rippleColor">@color/surface_variant</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="Widget.VietTable.Dialog.Button.Destructive" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/selector_dialog_btn_destructive_text</item>
        <item name="android:backgroundTint">@color/transparent</item>
        <item name="backgroundTint">@color/transparent</item>
        <item name="rippleColor">@color/semantic_error_bg</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.VietTable.Dialog.Button.Destructive.Filled" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/white</item>
        <item name="android:backgroundTint">@color/selector_btn_destructive_bg</item>
        <item name="backgroundTint">@color/selector_btn_destructive_bg</item>
        <item name="cornerRadius">@dimen/radius_medium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Dialog Theme Overlays -->
    <style name="ThemeOverlay.VietTable.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorAccent">@color/primary</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.VietTable.Dialog.Button.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.VietTable.Dialog.Button.Negative</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.VietTable.Dialog.Button.Neutral</item>
    </style>

    <style name="ThemeOverlay.VietTable.Dialog.Alert" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="colorAccent">@color/primary</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.VietTable.Dialog.Button.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.VietTable.Dialog.Button.Negative</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.VietTable.Dialog.Button.Neutral</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/Widget.VietTable.Dialog.Button.Positive</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/Widget.VietTable.Dialog.Button.Negative</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/Widget.VietTable.Dialog.Button.Neutral</item>
    </style>
</resources>
