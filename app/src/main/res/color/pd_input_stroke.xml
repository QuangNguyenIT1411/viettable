<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Input outline: yellow while focused, line colour otherwise (error colour comes from boxStrokeErrorColor). -->
    <item android:state_focused="true" android:color="@color/pd_yellow" />
    <item android:state_hovered="true" android:color="@color/pd_muted" />
    <item android:state_enabled="false" android:color="@color/pd_line" />
    <item android:color="@color/pd_line" />
</selector>
